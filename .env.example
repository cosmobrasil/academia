# FIREWORKS_API_KEY: Required for Fireworks LLM API calls.
# Configure this secret in your deployment environment (Railway/Netlify/Host).
FIREWORKS_API_KEY="MY_FIREWORKS_API_KEY"

# Optional: custom Fireworks endpoint and model
FIREWORKS_API_URL="https://api.fireworks.ai/v1/generate"
FIREWORKS_MODEL="fireworks-1"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
